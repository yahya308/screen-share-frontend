{
  "name": "screen-share-frontend",
  "version": "2.0.0",
  "description": "VELOSTREAM - High-Performance Screen Sharing Platform Frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "start": "npx serve public",
    "dev": "npx serve public",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/styles.css --minify",
    "build:vendor": "node scripts/build-vendor.js",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "mediasoup-client": "^3.18.1",
    "serve": "^14.2.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [
    "webrtc",
    "screen-share",
    "sfu",
    "streaming",
    "frontend"
  ],
  "author": "yahya308",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
