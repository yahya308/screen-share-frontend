# VELOSTREAM — ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayın ve doldurun. .env asla depoya girmez.

# ─────────────────────────── BACKEND (VPS / Docker Compose) ───────────────────────────

# Sunucunun genel IP'si. Mediasoup ICE adaylarını bu adresle duyurur;
# yanlışsa medya hiç akmaz.
ANNOUNCED_IP=203.0.113.10

# ZORUNLU (NODE_ENV=production iken). Virgülle ayrılmış origin listesi.
# Boş bırakılırsa sunucu açılışta durur — eskiden sessizce origin:'*' olurdu.
ALLOWED_ORIGINS=https://velostream.com.tr,https://www.velostream.com.tr

NODE_ENV=production

# Kaç mediasoup worker açılacak. Boş bırakılırsa os.availableParallelism().
# Konteynerde CPU kotanızla eşleştirin.
# MEDIASOUP_WORKERS=2

# Kötüye kullanım limitleri (varsayılanlar parantez içinde)
# MAX_ROOMS_PER_IP=3
# CREATE_ROOM_MAX=5          # 10 dakikalık pencerede IP başına oda oluşturma

# Günlükleme: error | warn | info | debug   (varsayılan info)
# LOG_FORMAT=json verirseniz satırlar JSON olur.
# LOG_LEVEL=info
# LOG_FORMAT=json

# /metrics erişimi. Tanımlıysa token zorunlu olur; tanımsızsa uç nokta
# yalnızca loopback/özel ağdan yanıt verir (dışarıya 404).
# METRICS_TOKEN=uzun-rastgele-bir-dize

# SQLite dosyasının yolu. Testler ':memory:' kullanır.
# ROOMS_DB_PATH=./rooms.db

# ─────────────────────────── VERCEL (ön yüz / serverless) ───────────────────────────

# Tarayıcının bağlanacağı sinyalleşme sunucusu (api/config bunu döndürür)
SIGNALING_URL=https://yahya-oracle.duckdns.org

# TURN. Yalnızca TURN_HOST tanımlıysa istemciye TURN sunucusu verilir.
# TURN_SECRET varsa coturn'ün "static-auth-secret" (REST API) modu kullanılır
# ve kimlik bilgileri kısa ömürlü üretilir; yoksa TURN_USERNAME/TURN_PASSWORD.
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TRANSPORTS=udp,tcp
TURN_REALM=velostream
TURN_SECRET=coturn-static-auth-secret
# TURN_TTL_SECONDS=900       # kısa tutun: uç nokta herkese açık
# TURN_ENABLE_TLS=true
# TURN_TLS_PORT=5349
# TURN_USERNAME=
# TURN_PASSWORD=
